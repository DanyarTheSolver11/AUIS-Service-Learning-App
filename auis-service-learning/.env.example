# Neon Postgres (use the pooled connection string for DATABASE_URL,
# and the direct/unpooled one for DIRECT_URL, per Prisma's Neon guide)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of emails that should get ADMIN access
# (e.g. the Student Services manager + you as IT support)
ADMIN_EMAILS="manager@auis.edu.krd,dd23103@auis.edu.krd"

# Gmail API (Google's own HTTPS API - not SMTP) - for supervisor
# confirmation emails. Sends as a specific Google account you authorize
# once via OAuth2, using the same Google Cloud project as login. No
# third-party email service, no DNS. Full step-by-step in README.md;
# short version:
# 1. Google Cloud Console -> APIs & Services -> Library -> enable "Gmail API"
# 2. Reuse your existing OAuth Client ID/Secret (the one from GOOGLE_CLIENT_ID
#    above) -> add https://developers.google.com/oauthplayground as an
#    Authorized redirect URI on it
# 3. Go to developers.google.com/oauthplayground -> gear icon -> "Use your
#    own OAuth credentials" -> paste that Client ID/Secret -> authorize the
#    Gmail API v1 "gmail.send" scope, signed in as the account that should
#    send these emails -> exchange for tokens -> copy the Refresh token
GMAIL_CLIENT_ID="" # same value as GOOGLE_CLIENT_ID above
GMAIL_CLIENT_SECRET="" # same value as GOOGLE_CLIENT_SECRET above
GMAIL_REFRESH_TOKEN=""
EMAIL_FROM="AUIS Volunteering Hours Tracker <the-account-you-authorized@auis.edu.krd>"

# Used inside emails to build the /approve/[token] link
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Secures the /api/cron/remind-pending endpoint. When you add this exact
# variable name in Vercel, Vercel automatically sends it as a Bearer
# token when triggering the scheduled job in vercel.json - generate any
# random string, e.g. `openssl rand -base64 24`.
CRON_SECRET=""
