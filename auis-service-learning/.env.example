# Neon Postgres (use the pooled connection string for DATABASE_URL,
# and the direct/unpooled one for DIRECT_URL, per Prisma's Neon guide)
DATABASE_URL="postgresql://user:pass@host/dbname?sslmode=require"
DIRECT_URL="postgresql://user:pass@host/dbname?sslmode=require"

# Google OAuth (Google Cloud Console -> Credentials -> OAuth Client ID)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# NextAuth
NEXTAUTH_SECRET="run: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Comma-separated list of emails that should get ADMIN access
# (e.g. the Student Services manager + you as IT support)
ADMIN_EMAILS="manager@auis.edu.krd,dd23103@auis.edu.krd"

# Resend (resend.com) - for supervisor approval emails
RESEND_API_KEY=""
EMAIL_FROM="AUIS Service Learning <noreply@yourdomain.com>"

# Used inside emails to build the /approve/[token] link
NEXT_PUBLIC_APP_URL="http://localhost:3000"
